{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "allowJs": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": ["./resources/scripts/*"]
        }
    },
    "include": [
        "resources/scripts/**/*.ts",
        "resources/scripts/**/*.tsx",
        "resources/scripts/**/*.d.ts"
    ]
}
